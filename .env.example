# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# Google Ads & Google Cloud OAuth 2.0 Credentials (dolarexpress-seo)
# ==============================================================================

# [OBLIGATORIA] Client ID de la credencial OAuth 2.0 (Tipo: Aplicación Web)
